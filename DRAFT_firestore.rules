rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Valid ID check
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper: Auth check
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Helper: Role checks
    function getAdminData() {
      return get(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAdmin() && getAdminData().role == 'super_admin';
    }

    // --- Entity Validations ---

    function isValidMember(data) {
      return data.name is string && data.name.size() <= 100
        && data.member_number is int
        && data.status in ['active', 'warning', 'inactive', 'archived']
        && data.level in ['Bronze', 'Silver', 'Gold', 'Diamond']
        && data.total_points is int && data.total_points >= 0
        && data.current_streak is int && data.current_streak >= 0
        && data.longest_streak is int && data.longest_streak >= 0
        && data.notes is string && data.notes.size() <= 2000
        && data.updated_at is string; // or timestamp
    }

    function isValidActivityLog(data) {
      return data.member_id is string && isValidId(data.member_id)
        && data.activity_date is string && data.activity_date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.is_active is bool
        && data.points_earned is int && data.points_earned >= 0 && data.points_earned <= 5
        && data.submitted_by == request.auth.uid;
    }

    // --- Collection Matches ---

    match /members/{memberId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidMember(request.resource.data) && isValidId(memberId);
      allow update: if (isSuperAdmin() || (isAdmin() && isValidMember(request.resource.data)))
                    && request.resource.data.member_number == resource.data.member_number; // ID immutable
      allow delete: if isSuperAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidActivityLog(request.resource.data) && isValidId(logId);
      allow update, delete: if isSuperAdmin();
    }

    match /admin_profiles/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin() && isValidId(adminId);
    }

    match /audit_trail/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(auditId);
      allow update, delete: if false; // Immutable logs
    }

    match /badges/{badgeId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(badgeId);
      allow delete: if isSuperAdmin();
    }
  }
}
